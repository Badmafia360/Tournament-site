{
  "name": "freefire-arena",
  "version": "1.0.0",
  "private": true,
  "description": "Free Fire tournament platform MVP",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "node server/src/seed.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
